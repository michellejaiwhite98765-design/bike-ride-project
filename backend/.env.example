PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://bikeride:bikeride@localhost:5433/bikeride?schema=public"
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
MAP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_PICKUP_RADIUS_KM=2
DEFAULT_DESTINATION_RADIUS_KM=2
DEFAULT_TIME_WINDOW_MINUTES=30
PLATFORM_FEE_FLAT=5
TRACKING_SNAPSHOT_INTERVAL_MS=20000
TRACKING_STALE_AFTER_MS=30000


# Vehicle RC OCR uses the tesseract-ocr binary installed by Docker.
# The local/dev machine must have tesseract + poppler-utils installed to support image/PDF RC OCR.
RC_OCR_TIMEOUT_MS=45000
RC_OCR_MAX_PAGES=3
