PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://bikeride:bikeride@localhost:5433/bikeride?schema=public"
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
MAP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_PICKUP_RADIUS_KM=2
DEFAULT_DESTINATION_RADIUS_KM=2
DEFAULT_TIME_WINDOW_MINUTES=30
PLATFORM_FEE_FLAT=5
# How far (km) a passenger's pickup/drop may be from the ride's road route to join:
# ON_ROUTE rides (passenger meets the rider on the road) / PASSENGER_LOCATION rides (rider detours)
JOIN_RADIUS_ON_ROUTE_KM=1
JOIN_RADIUS_PASSENGER_LOCATION_KM=2
# Rider can start a ride from this many minutes before its departure time
RIDE_EARLY_START_MINUTES=30
# A ride never started is closed (EXPIRED) this many minutes after its departure time
RIDE_EXPIRE_AFTER_MINUTES=120
# Rides may only take place inside this country (bounding box)
SERVICE_COUNTRY_NAME=India
SERVICE_MIN_LAT=6.0
SERVICE_MAX_LAT=37.6
SERVICE_MIN_LNG=68.0
SERVICE_MAX_LNG=97.5
# Departure times are local time; offset from UTC in minutes (330 = IST)
APP_TZ_OFFSET_MINUTES=330
TRACKING_SNAPSHOT_INTERVAL_MS=20000
TRACKING_STALE_AFTER_MS=30000


# Vehicle RC OCR uses the tesseract-ocr binary installed by Docker.
# The local/dev machine must have tesseract + poppler-utils installed to support image/PDF RC OCR.
RC_OCR_TIMEOUT_MS=45000
RC_OCR_MAX_PAGES=3
