PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://bikeride:bikeride@localhost:5433/bikeride?schema=public"
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
MAP_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_PICKUP_RADIUS_KM=2
DEFAULT_DESTINATION_RADIUS_KM=2
DEFAULT_TIME_WINDOW_MINUTES=30
PLATFORM_FEE_FLAT=5
# Two-zone pickup (src/utils/pickupZone.js): normal pickup within
# PICKUP_ON_ROUTE_KM of the rider's road route; beyond that the rider can
# detour up to DETOUR_MAX_PERCENT of the route (max DETOUR_MAX_KM), and the
# fare goes up by TIP_RATE_PER_KM (or the ride's own per-km rate) per extra km.
PICKUP_ON_ROUTE_KM=2.5
DETOUR_MAX_PERCENT=20
DETOUR_MAX_KM=30
TIP_RATE_PER_KM=5
# Trip lifecycle: departure times are local (RIDE_TIMEZONE); rides never
# started expire RIDE_EXPIRE_AFTER_HOURS after departure; accepted passengers
# must pay within PAYMENT_DEADLINE_MINUTES or their seat is released.
RIDE_TIMEZONE=Asia/Kolkata
RIDE_EXPIRE_AFTER_HOURS=2
PAYMENT_DEADLINE_MINUTES=30
LIFECYCLE_SWEEP_INTERVAL_MS=60000
# Road routing (OSRM) used to save each ride's real road route.
ROUTING_ENABLED=true
ROUTING_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=8000
TRACKING_SNAPSHOT_INTERVAL_MS=20000
TRACKING_STALE_AFTER_MS=30000


# Vehicle RC OCR uses the tesseract-ocr binary installed by Docker.
# The local/dev machine must have tesseract + poppler-utils installed to support image/PDF RC OCR.
RC_OCR_TIMEOUT_MS=45000
RC_OCR_MAX_PAGES=3
